[Unit]
Description=mousemap - remapeamento dos botões extras do mouse
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=notify
BusName=io.github.mousemap.Daemon
ExecStart=@BINDIR@/mousemapd
Restart=on-failure
RestartSec=3
WatchdogSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
